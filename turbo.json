{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.mjs"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "build:web": {
      "dependsOn": ["^typecheck"],
      "env": ["EXPO_PUBLIC_*", "GITHUB_SHA"],
      "outputs": ["dist/**"]
    }
  }
}
