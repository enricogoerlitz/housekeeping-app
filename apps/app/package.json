{
  "name": "@housekeeping/app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "build:web": "expo export --platform web && node scripts/finish-web-export.mjs && node scripts/check-web-export.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/app-config.test.mjs scripts/check-web-export.test.mjs scripts/sw-push.test.mjs scripts/theme-boot.test.mjs scripts/url-params-usage.test.mjs scripts/list-state.test.mjs scripts/stack-options.test.mjs"
  },
  "dependencies": {
    "@housekeeping/api": "workspace:*",
    "@housekeeping/core": "workspace:*",
    "@housekeeping/ui": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-system-ui": "~58.0.7",
    "microsoft-cognitiveservices-speech-sdk": "1.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "7.29.14",
    "@babel/preset-typescript": "7.29.7",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "workbox-build": "7.4.1"
  }
}
