-- Shared pgTAP helpers. Every test file includes this right after `begin;` with
--   \ir _helpers.psql
-- Everything created here lives inside the test transaction and is rolled back with it, so the
-- database keeps no test objects. The file extension is not .sql, so pg_prove does not run it.

-- pgTAP is installed by `supabase test db` as postgres. The foundation migration revokes the
-- default EXECUTE from PUBLIC, so the assertion functions must be granted to the API roles for
-- assertions that run while a test is authenticated as a user or as anon.
do $$
declare
  f regprocedure;
begin
  for f in
    select p.oid::regprocedure
    from pg_catalog.pg_proc p
    join pg_catalog.pg_depend d
      on d.classid = 'pg_catalog.pg_proc'::regclass and d.objid = p.oid and d.deptype = 'e'
    join pg_catalog.pg_extension e on e.oid = d.refobjid
    where e.extname = 'pgtap'
  loop
    execute format('grant execute on function %s to anon, authenticated', f);
  end loop;
end
$$;

create schema tests;
grant usage on schema tests to anon, authenticated;

-- Creates an auth user the way GoTrue does (fires the profile/invitation trigger) and returns
-- its id. Call as postgres (before authenticating or after tests.clear_authentication()).
create function tests.create_user(
  p_email text,
  p_name text default null,
  p_provider text default 'google'
) returns uuid
language plpgsql
as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.users (
    instance_id, id, aud, role, email, raw_app_meta_data, raw_user_meta_data, created_at, updated_at
  ) values (
    '00000000-0000-0000-0000-000000000000', v_id, 'authenticated', 'authenticated', p_email,
    jsonb_build_object('provider', p_provider, 'providers', jsonb_build_array(p_provider)),
    case when p_name is null then '{}'::jsonb else jsonb_build_object('full_name', p_name) end,
    now(), now()
  );
  return v_id;
end
$$;

-- Fixture: a household with the given members (first one is the creator). Bypasses the RPC on
-- purpose so RLS tests do not depend on it. Call as postgres.
create function tests.create_household(p_name text, p_member_ids uuid[]) returns uuid
language plpgsql
as $$
declare
  v_id uuid;
begin
  insert into public.households (name) values (p_name) returning id into v_id;
  insert into public.household_members (household_id, profile_id)
  select v_id, m from unnest(p_member_ids) as m;
  return v_id;
end
$$;

-- Switches the session to a signed-in user, like PostgREST does for a valid JWT.
-- No SET clause on purpose: it would undo the local settings when the function returns.
create function tests.authenticate_as(p_user_id uuid) returns void
language plpgsql
as $$
begin
  perform set_config('role', 'authenticated', true);
  perform set_config(
    'request.jwt.claims',
    json_build_object('sub', p_user_id, 'role', 'authenticated')::text,
    true
  );
end
$$;

-- Switches the session to a signed-out caller (anon key, no user).
create function tests.authenticate_as_anon() returns void
language plpgsql
as $$
begin
  perform set_config('role', 'anon', true);
  perform set_config('request.jwt.claims', json_build_object('role', 'anon')::text, true);
end
$$;

-- Back to postgres (the session user) for fixtures and checks that need to see everything.
create function tests.clear_authentication() returns void
language plpgsql
as $$
begin
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claims', '', true);
end
$$;

-- Runs one statement as the current role and returns how many rows it touched. RLS hides rows
-- without an error, so "0 rows changed" is how a denied update or delete shows up.
create function tests.affected(p_sql text) returns int
language plpgsql
as $$
declare
  v_count int;
begin
  execute p_sql;
  get diagnostics v_count = row_count;
  return v_count;
end
$$;

-- Tenant isolation of a household-scoped table that members write directly (AC-005, AC-011).
--   p_row:   a valid new row in the member's household, with id and household_id, using only
--            columns a member may insert (references point into the same household)
--   p_patch: columns a member may update, with valid values
-- Checks the member can insert, read, update and delete it (leaving a tombstone only members
-- see); a member of another household reads nothing and changes nothing; nobody can move the
-- row to another household; anon can do nothing. Returns 15 pgTAP results; call as postgres.
-- p_direct_delete = false: the table has no delete grant (articles are deleted only by an RPC,
-- spec 0007 E4), so every direct delete is refused with 42501; the row is then deleted as postgres
-- to check the tombstone.
-- p_direct_update = false: the table has no update grant (packing items change only through
-- set_packing_items_packed, spec 0012), so every direct update is refused with 42501.
create function tests.tenant_isolation(
  p_table text,
  p_row jsonb,
  p_patch jsonb,
  p_member uuid,
  p_foreign uuid,
  p_direct_delete boolean default true,
  p_direct_update boolean default true
) returns setof text
language plpgsql
as $$
declare
  v_rel text := format('public.%I', p_table);
  v_id uuid := (p_row ->> 'id')::uuid;
  v_household_id uuid := (p_row ->> 'household_id')::uuid;
  v_foreign_household_id uuid;
  v_cols text;
  v_set text;
  v_insert text;
  v_foreign_insert text;
  v_update text;
  v_delete text;
begin
  select m.household_id into v_foreign_household_id
  from public.household_members m
  where m.profile_id = p_foreign and m.household_id <> v_household_id
  limit 1;

  select string_agg(format('%I', k), ', ') into v_cols from jsonb_object_keys(p_row) k;
  select string_agg(format('%1$I = r.%1$I', k), ', ') into v_set from jsonb_object_keys(p_patch) k;
  v_insert := format('insert into %1$s (%2$s) select %2$s from jsonb_populate_record(null::%1$s, %3$L::jsonb)',
                     v_rel, v_cols, p_row);
  v_foreign_insert := format('insert into %1$s (%2$s) select %2$s from jsonb_populate_record(null::%1$s, %3$L::jsonb)',
                             v_rel, v_cols, p_row || jsonb_build_object('id', gen_random_uuid()));
  v_update := format('update %1$s t set %2$s from jsonb_populate_record(null::%1$s, %3$L::jsonb) r where t.id = %4$L',
                     v_rel, v_set, p_patch, v_id);
  v_delete := format('delete from %s where id = %L', v_rel, v_id);

  perform tests.authenticate_as(p_member);
  return next lives_ok(v_insert, format('AC-011 %s: a member inserts a row into her household', p_table));
  return next is(
    tests.affected(format('select 1 from %s where id = %L', v_rel, v_id)), 1,
    format('AC-011 %s: a member reads the row', p_table));
  if p_direct_update then
    return next is(tests.affected(v_update), 1, format('AC-011 %s: a member updates the editable columns', p_table));
  else
    return next throws_ok(v_update, '42501', null, format('T1 %s: a member cannot update directly', p_table));
  end if;
  return next throws_ok(
    format('update %s set household_id = %L where id = %L', v_rel, v_foreign_household_id, v_id),
    '42501', null,
    format('AC-011 %s: a member cannot move the row to another household', p_table));

  perform tests.authenticate_as(p_foreign);
  return next is(
    tests.affected(format('select 1 from %s where household_id = %L', v_rel, v_household_id)), 0,
    format('AC-011 %s: a member of another household reads no rows', p_table));
  if p_direct_update then
    return next is(tests.affected(v_update), 0, format('AC-011 %s: a member of another household updates nothing', p_table));
  else
    return next throws_ok(v_update, '42501', null,
      format('AC-011 %s: a member of another household cannot update directly', p_table));
  end if;
  if p_direct_delete then
    return next is(tests.affected(v_delete), 0, format('AC-011 %s: a member of another household deletes nothing', p_table));
  else
    return next throws_ok(v_delete, '42501', null,
      format('AC-011 %s: a member of another household cannot delete directly', p_table));
  end if;
  return next throws_ok(v_foreign_insert, null::char(5), null,
    format('AC-011 %s: a member of another household cannot insert with this household_id', p_table));

  perform tests.authenticate_as_anon();
  return next throws_ok(format('select * from %s', v_rel), '42501', null,
    format('AC-005 %s: anon cannot read', p_table));
  return next throws_ok(v_foreign_insert, '42501', null, format('AC-005 %s: anon cannot insert', p_table));
  return next throws_ok(v_update, '42501', null, format('AC-005 %s: anon cannot update', p_table));
  return next throws_ok(v_delete, '42501', null, format('AC-005 %s: anon cannot delete', p_table));

  perform tests.authenticate_as(p_member);
  if p_direct_delete then
    return next is(tests.affected(v_delete), 1, format('AC-011 %s: a member deletes the row', p_table));
  else
    return next throws_ok(v_delete, '42501', null, format('E4 %s: a member cannot delete the row directly', p_table));
    perform tests.clear_authentication();
    execute v_delete;
    perform tests.authenticate_as(p_member);
  end if;
  return next is(
    tests.affected(format('select 1 from public.deleted_records where table_name = %L and record_id = %L',
                          p_table, v_id)), 1,
    format('AC-015 %s: the delete leaves a tombstone the member reads', p_table));

  perform tests.authenticate_as(p_foreign);
  return next is(
    tests.affected(format('select 1 from public.deleted_records where table_name = %L and record_id = %L',
                          p_table, v_id)), 0,
    format('AC-011 %s: a member of another household does not see the tombstone', p_table));

  perform tests.clear_authentication();
end
$$;

-- Isolation of a table that members never write directly (favourites, ratings, votes go through
-- set_* RPCs). p_row is a would-be row in the member's household. Expects at least one row of the
-- household to exist already. Returns 7 pgTAP results; call as postgres.
create function tests.rpc_only_isolation(p_table text, p_row jsonb, p_member uuid, p_foreign uuid)
returns setof text
language plpgsql
as $$
declare
  v_rel text := format('public.%I', p_table);
  v_household_id uuid := (p_row ->> 'household_id')::uuid;
  v_cols text;
  v_insert text;
begin
  select string_agg(format('%I', k), ', ') into v_cols from jsonb_object_keys(p_row) k;
  v_insert := format('insert into %1$s (%2$s) select %2$s from jsonb_populate_record(null::%1$s, %3$L::jsonb)',
                     v_rel, v_cols, p_row);

  perform tests.authenticate_as(p_member);
  return next ok(
    tests.affected(format('select 1 from %s where household_id = %L', v_rel, v_household_id)) > 0,
    format('AC-011 %s: a member reads the rows of her household', p_table));
  return next throws_ok(v_insert, '42501', null, format('T3 %s: a member cannot insert directly', p_table));
  return next throws_ok(format('update %s set updated_at = now()', v_rel), '42501', null,
    format('T3 %s: a member cannot update directly', p_table));
  return next throws_ok(format('delete from %s', v_rel), '42501', null,
    format('T3 %s: a member cannot delete directly', p_table));

  perform tests.authenticate_as(p_foreign);
  return next is(
    tests.affected(format('select 1 from %s where household_id = %L', v_rel, v_household_id)), 0,
    format('AC-011 %s: a member of another household reads no rows', p_table));

  perform tests.authenticate_as_anon();
  return next throws_ok(format('select * from %s', v_rel), '42501', null,
    format('AC-005 %s: anon cannot read', p_table));
  return next throws_ok(v_insert, '42501', null, format('AC-005 %s: anon cannot insert', p_table));

  perform tests.clear_authentication();
end
$$;

-- ---------- Notifications (spec 0013) ----------

-- A moment given in the local time of Europe/Berlin, e.g. tests.berlin('2026-11-20 07:30').
create function tests.berlin(p_local timestamp) returns timestamptz
language sql immutable
as $$ select p_local at time zone 'Europe/Berlin' $$;

-- Valid Web Push keys of the right shape (65-byte P-256 point, 16-byte auth secret, base64url).
create function tests.p256dh() returns text language sql immutable as $$ select 'B' || repeat('A', 86) $$;
create function tests.push_auth() returns text language sql immutable as $$ select repeat('A', 22) $$;

-- A push subscription inserted directly (as postgres), bypassing the RPC and its limits.
create function tests.add_push_subscription(p_profile_id uuid, p_name text, p_enabled boolean default true)
returns uuid
language plpgsql
as $$
declare
  v_id uuid;
begin
  insert into private.push_subscriptions (profile_id, endpoint, p256dh, auth, device_label, enabled)
  values (p_profile_id, 'https://fcm.googleapis.com/fcm/send/' || p_name, tests.p256dh(), tests.push_auth(), p_name,
          p_enabled)
  returning id into v_id;
  return v_id;
end
$$;

-- The two Vault entries of the push hand-over with made-up test values (never real secrets);
-- rolled back with the test. tests.clear_push_vault() removes them, so a developer's local
-- entries never influence a test.
create function tests.set_push_vault() returns void
language plpgsql
as $$
begin
  perform tests.clear_push_vault();
  perform vault.create_secret('test-push-secret', 'push_send_secret');
  perform vault.create_secret('http://push-send.test/functions/v1/push-send', 'push_send_url');
end
$$;

create function tests.clear_push_vault() returns void
language plpgsql
as $$
begin
  delete from vault.secrets where name in ('push_send_secret', 'push_send_url');
end
$$;

grant execute on all functions in schema tests to anon, authenticated;
