-- Shared pgTAP helpers. Every test file includes this right after `begin;` with
--   \ir _helpers.psql
-- Everything created here lives inside the test transaction and is rolled back with it, so the
-- database keeps no test objects. The file extension is not .sql, so pg_prove does not run it.

-- pgTAP is installed by `supabase test db` as postgres. The foundation migration revokes the
-- default EXECUTE from PUBLIC, so the assertion functions must be granted to the API roles for
-- assertions that run while a test is authenticated as a user or as anon.
do $$
declare
  f regprocedure;
begin
  for f in
    select p.oid::regprocedure
    from pg_catalog.pg_proc p
    join pg_catalog.pg_depend d
      on d.classid = 'pg_catalog.pg_proc'::regclass and d.objid = p.oid and d.deptype = 'e'
    join pg_catalog.pg_extension e on e.oid = d.refobjid
    where e.extname = 'pgtap'
  loop
    execute format('grant execute on function %s to anon, authenticated', f);
  end loop;
end
$$;

create schema tests;
grant usage on schema tests to anon, authenticated;

-- Creates an auth user the way GoTrue does (fires the profile/invitation trigger) and returns
-- its id. Call as postgres (before authenticating or after tests.clear_authentication()).
create function tests.create_user(
  p_email text,
  p_name text default null,
  p_provider text default 'google'
) returns uuid
language plpgsql
as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.users (
    instance_id, id, aud, role, email, raw_app_meta_data, raw_user_meta_data, created_at, updated_at
  ) values (
    '00000000-0000-0000-0000-000000000000', v_id, 'authenticated', 'authenticated', p_email,
    jsonb_build_object('provider', p_provider, 'providers', jsonb_build_array(p_provider)),
    case when p_name is null then '{}'::jsonb else jsonb_build_object('full_name', p_name) end,
    now(), now()
  );
  return v_id;
end
$$;

-- Fixture: a household with the given members (first one is the creator). Bypasses the RPC on
-- purpose so RLS tests do not depend on it. Call as postgres.
create function tests.create_household(p_name text, p_member_ids uuid[]) returns uuid
language plpgsql
as $$
declare
  v_id uuid;
begin
  insert into public.households (name) values (p_name) returning id into v_id;
  insert into public.household_members (household_id, profile_id)
  select v_id, m from unnest(p_member_ids) as m;
  return v_id;
end
$$;

-- Switches the session to a signed-in user, like PostgREST does for a valid JWT.
-- No SET clause on purpose: it would undo the local settings when the function returns.
create function tests.authenticate_as(p_user_id uuid) returns void
language plpgsql
as $$
begin
  perform set_config('role', 'authenticated', true);
  perform set_config(
    'request.jwt.claims',
    json_build_object('sub', p_user_id, 'role', 'authenticated')::text,
    true
  );
end
$$;

-- Switches the session to a signed-out caller (anon key, no user).
create function tests.authenticate_as_anon() returns void
language plpgsql
as $$
begin
  perform set_config('role', 'anon', true);
  perform set_config('request.jwt.claims', json_build_object('role', 'anon')::text, true);
end
$$;

-- Back to postgres (the session user) for fixtures and checks that need to see everything.
create function tests.clear_authentication() returns void
language plpgsql
as $$
begin
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claims', '', true);
end
$$;

grant execute on all functions in schema tests to anon, authenticated;
