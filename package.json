{
  "name": "housekeeping",
  "private": true,
  "packageManager": "pnpm@11.28.13",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @housekeeping/app start",
    "ios": "pnpm --filter @housekeeping/app ios",
    "android": "pnpm --filter @housekeeping/app android",
    "web": "pnpm --filter @housekeeping/app web",
    "build:web": "turbo run build:web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "node scripts/gen-edge.mjs --check && turbo run lint typecheck test",
    "gen:edge": "node scripts/gen-edge.mjs",
    "e2e": "pnpm --filter @housekeeping/e2e e2e",
    "demo:video": "pnpm --filter @housekeeping/e2e demo:video",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.10.1",
    "supabase": "3.2.0",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3"
  }
}
