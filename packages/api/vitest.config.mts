import { defineConfig } from 'vitest/config';

// Coverage (spec 0031, REQ-005): `pnpm test` measures every source file, also those no test
// loads, and fails below 80 % of the lines. Single test files and the integration tests run
// without it.
export default defineConfig({
  test: {
    coverage: {
      provider: 'v8',
      include: ['src/**/*.ts'],
      exclude: [
        // The tests themselves (also *.backend.test.ts and *.integration.test.ts).
        'src/**/*.test.ts',
        // Helpers of the tests: the in-memory server and the shared setup, not product code.
        'src/transport-fake.ts',
        'src/backend-test-helpers.ts',
        'src/test-helpers.ts',
        // Generated by `pnpm db:types`.
        'src/**/*.gen.ts',
      ],
      reporter: ['text-summary'],
      thresholds: { lines: 80 },
    },
  },
});
