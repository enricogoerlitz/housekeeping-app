# Names only — never put real values here. Real values live in .env (git-ignored).

# Google OAuth (web client) — read by supabase/config.toml for the local stack
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Foundry, OpenAI-compatible v1 API — server-side only (Supabase Edge Functions).
# Never prefix these with EXPO_PUBLIC_: that would ship them inside the app.
# Base URL without a path suffix, e.g. https://<resource>.services.ai.azure.com/openai/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Deployment names in Foundry
OPENAI_LLM_MODEL=
OPENAI_STT_MODEL=

# App — public values, bundled into the app. Filled in by the first data spec.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
