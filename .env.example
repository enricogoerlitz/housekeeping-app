# Names and non-secret defaults only — never put real secrets here. Real values live in .env
# (git-ignored). Copy this file to .env and fill in the empty values.

# --- Google OAuth (web client) -------------------------------------------------------------
# Read by supabase/config.toml for the local stack.
# Source: Google Cloud Console → Google Auth Platform → Clients → "Housekeeping Web"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Local seed (`pnpm db:reset`) ------------------------------------------------------------
# Optional: your real Google address. `pnpm db:reset` invites it to the seed households
# "Enrico & Nadja" and "Test"; after your first local Google sign-in you accept them in the app.
# Empty = only the test accounts (enrico.test@example.com, nadja.test@example.com).
DEV_OWNER_EMAIL=

# --- Microsoft Foundry — server-side only (Supabase Edge Functions) ---------------------------
# Never prefix these with EXPO_PUBLIC_: that would ship them inside the app.
# Source: Foundry → Home → "API key" (one key for the LLM and for Speech)
FOUNDRY_API_KEY=
# Source: Foundry → Home → "Azure OpenAI endpoint", e.g. https://<resource>.openai.azure.com/openai/v1
FOUNDRY_OPENAI_BASE_URL=
# Source: Foundry → Models → name of your LLM deployment
FOUNDRY_LLM_DEPLOYMENT=
# Source: Azure region of the Foundry resource (Foundry → Manage, or Azure Portal → resource →
# Overview → Location), lowercase without spaces, e.g. swedencentral
FOUNDRY_SPEECH_REGION=westeurope
# Speech-to-text via the Azure Speech SDK (streaming, no deployment needed).
# Empty model = Azure Speech standard model: GA, works in every region, tested with de-DE.
# "mai-transcribe-2-streaming" only works if the resource is in swedencentral, centralus, eastus2
# or southeastasia (preview) — not in westeurope.
FOUNDRY_STT_MODEL=
FOUNDRY_STT_LANGUAGE=de-DE
# Source: Foundry → Models → name of your image deployment (generation and editing), e.g.
# FLUX.2-pro (Black Forest Labs, GlobalStandard). Called via
# https://<resource>.services.ai.azure.com/providers/blackforestlabs/v1/flux-2-pro?api-version=preview
FOUNDRY_IMAGE_DEPLOYMENT=

# --- Web search (spec 0049) — server-side only (Supabase Edge Function web-search) ------------
# Source: serper.dev → Dashboard → "API Key" (Google results; POST google.serper.dev/search, /maps)
SERPER_API_KEY=
# Fallback when Serper fails or is out of credits.
# Source: api-dashboard.search.brave.com → API Keys (plan "Free AI" or "Data for Search")
BRAVE_SEARCH_API_KEY=

# --- KI-Agent (spec 0066, 0067; ADR-0019, ADR-0020) — server-side only (Supabase Edge Function ai-agent) -------
# Runtime with FOUNDRY_API_KEY above; the agent foundry/agents/household-agent.yaml is created with
# Entra by `pnpm foundry:agents:local` (docs/architecture/betrieb.md, "KI-Agent").
# Source: Foundry → project → Overview → "Project endpoint",
# e.g. https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_HOUSEHOLD_AGENT=household-agent-local
# Empty = the latest version of the local agent; or the number `pnpm foundry:agents:local` names.
FOUNDRY_HOUSEHOLD_AGENT_VERSION=
# Only for `pnpm foundry:agents:local` when `az login` holds several accounts: the subscription
# of the Foundry resource (name or id).
FOUNDRY_SUBSCRIPTION=

# --- App: public values, bundled into the app ----------------------------------------------
# Local development points at the local Supabase in Docker.
# Source: `pnpm exec supabase status` → "API URL" and "Publishable key"
# (Production values are set in the hosting/build environment, not here.)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Local default of the Supabase CLI — identical on every machine, not a secret.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Developer switch: "1" offers the local test accounts on the login page ("Als Test-Enrico
# anmelden"). Only for local development: the app refuses to start when it is set and
# EXPO_PUBLIC_SUPABASE_URL is not localhost/127.0.0.1. Leave empty everywhere else.
EXPO_PUBLIC_DEV_LOGIN=
# App version (spec 0014): the release pipeline sets it ("JJJJ.M.N", "vorschau" in the preview).
# Empty = "dev": no "Neue Version verfügbar" hint and no minimum-version lock.
EXPO_PUBLIC_APP_VERSION=
